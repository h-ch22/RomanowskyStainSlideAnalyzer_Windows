<Window x:Class="FeatureInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FeatureInstaller"
        mc:Ignorable="d"
        Title="Romanowsky Stain Slide Analyzer Feature Activator" Height="450" Width="800" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image Width="80" Height="80" Source="pack://application:,,,/Assets/ic_main.png"/>
            <TextBlock Text="Romanowsky Stain Slide Analyzer" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" TextAlignment="Center" Margin="10 0 0 0"/>
        </StackPanel>

        <StackPanel Orientation="Vertical" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <ProgressBar Width="600" Height="10" x:Name="progressBar" Minimum="0" Maximum="100" Value="{Binding progress}"/>
            <TextBlock Text="{Binding status}" Margin="0 10 0 0" TextAlignment="Center" HorizontalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer ScrollChanged="ScrollViewer_ScrollChanged" x:Name="scrollViewer" Grid.Row="2" Margin="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">

            <StackPanel Background="LightGray" Orientation="Vertical" Margin="10">
                <TextBlock Margin="0 5 0 5" Text="Output" FontWeight="SemiBold"/>
                <TextBlock ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" Text="{Binding output}" TextWrapping="Wrap" />

            </StackPanel>
        </ScrollViewer>
        

    </Grid>
</Window>
