<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="RomanowskyStainSlideAnalyzer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:frameworkModels="using:RomanowskyStainSlideAnalyzer.Frameworks.Models"
    xmlns:local="using:RomanowskyStainSlideAnalyzer">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="ReleaseNoteItemTemplate">
                <ItemContainer AutomationProperties.Name="{Binding Key}">
                    <Grid VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="8*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{Binding Key}" FontWeight="SemiBold" FontSize="18" />

                        <TextBlock Grid.Column="1" TextAlignment="Left" HorizontalAlignment="Left" HorizontalTextAlignment="Left" Margin="0 25" Text="{Binding Values}"/>
                    </Grid>
                </ItemContainer>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
