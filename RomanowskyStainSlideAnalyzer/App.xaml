<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="RomanowskyStainSlideAnalyzer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:frameworkModels="using:RomanowskyStainSlideAnalyzer.Frameworks.Models"
    xmlns:local="using:RomanowskyStainSlideAnalyzer">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="ReleaseNoteItemTemplate">
                <ItemContainer AutomationProperties.Name="{Binding Key}">
                    <Grid VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="8*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{Binding Key}" FontWeight="SemiBold" FontSize="18" />

                        <TextBlock Grid.Column="1" TextAlignment="Left" HorizontalAlignment="Left" HorizontalTextAlignment="Left" Margin="0 25" Text="{Binding Values}"/>
                    </Grid>
                </ItemContainer>
            </DataTemplate>

            <DataTemplate x:Key="LabeledDataItemTemplate">
                <ItemContainer AutomationProperties.Name="{Binding Id}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Width="120" Height="120" Grid.Column="0" Source="{Binding ImagePath}" Stretch="Uniform"/>

                        <TextBlock Margin="10 0 0 0" Grid.Column="1" Text="{Binding Id}"/>
                    </Grid>
                </ItemContainer>
            </DataTemplate>

            <DataTemplate x:Key="LabelingDataPreviewListHeaderTemplate">
                <ItemContainer>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="1.6*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Index" Grid.Column="0" TextAlignment="Center" HorizontalAlignment="Center" HorizontalTextAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="Class" Grid.Column="1" TextAlignment="Center" HorizontalAlignment="Center" HorizontalTextAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="X" Grid.Column="2" TextAlignment="Center" HorizontalAlignment="Center" HorizontalTextAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="Y" Grid.Column="3" TextAlignment="Center" HorizontalAlignment="Center" HorizontalTextAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="Width" Grid.Column="4" TextAlignment="Center" HorizontalAlignment="Center" HorizontalTextAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="Height" Grid.Column="5" TextAlignment="Center" HorizontalAlignment="Center" HorizontalTextAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </ItemContainer>
            </DataTemplate>

            <DataTemplate x:Key="LabelingDataPreviewListContentsTemplate">
                <ItemContainer AutomationProperties.Name="{Binding id}">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="1.6*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding id}" Grid.Column="0" TextAlignment="Center" HorizontalAlignment="Center" HorizontalTextAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding classId}" Grid.Column="1" TextAlignment="Center" HorizontalAlignment="Center" HorizontalTextAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding x}" Grid.Column="2" TextAlignment="Center" HorizontalAlignment="Center" HorizontalTextAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding y}" Grid.Column="3" TextAlignment="Center" HorizontalAlignment="Center" HorizontalTextAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding width}" Grid.Column="4" TextAlignment="Center" HorizontalAlignment="Center" HorizontalTextAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding height}" Grid.Column="5" TextAlignment="Center" HorizontalAlignment="Center" HorizontalTextAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </ItemContainer>
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
