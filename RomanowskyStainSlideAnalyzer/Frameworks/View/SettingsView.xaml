<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RomanowskyStainSlideAnalyzer.Frameworks.View.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RomanowskyStainSlideAnalyzer.Frameworks.View"
    xmlns:model="using:RomanowskyStainSlideAnalyzer.Frameworks.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="SettingsExpanderItemTemplate" x:DataType="model:EnvironmentDataModel">
            <ItemContainer AutomationProperties.Name="{x:Bind Title}">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Title}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <ProgressRing Width="20" Height="20" Visibility="{x:Bind ProgressBarVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        
                        <HyperlinkButton x:Name="btn_refresh" Click="Refresh" Visibility="{x:Bind RefreshButtonVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <HyperlinkButton.Content>
                                <StackPanel Orientation="Horizontal">
                                    <SymbolIcon Symbol="Refresh"/>
                                    <TextBlock Text="Refresh" Margin="10 0 0 0"/>
                                </StackPanel>
                            </HyperlinkButton.Content>
                        </HyperlinkButton>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <SymbolIcon Symbol="{x:Bind SymbolIcon}"/>
                        <TextBlock Margin="10 0 0 0" Text="{x:Bind StatusText}"/>
                    </StackPanel>

                </Grid>
            </ItemContainer>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalAlignment="Stretch">
        <Grid Padding="60 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel VerticalAlignment="Stretch" Margin="0 10 0 0" Orientation="Vertical" Grid.Row="0">
                <ProgressRing VerticalAlignment="Center" HorizontalAlignment="Center" IsIndeterminate="True" Visibility="{Binding ShowProgress, Mode=TwoWay}"/>
                
                <Expander
                    x:Name="EnvironmentExpander"
                    IsExpanded="True"
                    ExpandDirection="Down"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">

                    <Expander.Header>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="9*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                <SymbolIcon Symbol="Setting"/>
                                <TextBlock Margin="10 0 0 0" Text="Environment Status"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <SymbolIcon Symbol="{Binding EnvironmentSymbol}"/>
                                <TextBlock Margin="10 0 0 0" Text="{Binding IsEnvironmentSet, Mode=TwoWay}"/>
                            </StackPanel>

                        </Grid>
                    </Expander.Header>

                    <Expander.Content>
                        <ListView
                            SelectionMode="None"
                            ItemTemplate="{StaticResource SettingsExpanderItemTemplate}"
                            BorderThickness="0"
                            BorderBrush="{ThemeResource SystemControlTransparentBrush}"
                            ItemsSource="{Binding Datas, Mode=TwoWay}"
                            HorizontalContentAlignment="Stretch"/>
                    </Expander.Content>

                </Expander>
                
                <Expander
                    IsExpanded="False"
                    ExpandDirection="Down"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Content="Free up space on your computer by removing Segmentation History.">

                    <Expander.Header>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="9*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                <SymbolIcon Symbol="Clear"/>
                                <TextBlock Margin="10 0 0 0" Text="Clear History"/>
                            </StackPanel>

                            <Button x:Name="btn_clearHistory" Click="Button_Click" Grid.Column="1" HorizontalAlignment="Right" HorizontalContentAlignment="Center">Clear</Button>
                        </Grid>
                    </Expander.Header>

                </Expander>

            </StackPanel>

            <StackPanel Margin="0 10 0 0" Orientation="Vertical" Grid.Row="1">
                <TextBlock Text="About this App" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding AppName, Mode=TwoWay}"/>
                <TextBlock Text="ⓒ 2024 Changjin Ha. All rights reserved."/>
            </StackPanel>
        </Grid>
    </ScrollViewer>

</Page>
