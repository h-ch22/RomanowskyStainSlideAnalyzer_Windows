<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="RomanowskyStainSlideAnalyzer.Frameworks.View.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RomanowskyStainSlideAnalyzer.Frameworks.View"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Romanowsky Stain Slide Analyzer"
    mc:Ignorable="d">

    <Grid>
        <Grid x:Name="AppTitleBar" Height="48" Margin="48,0,0,0" VerticalAlignment="Top" Padding="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image Source="ms-appx:///Assets/ic_main.png"
                   x:Name="ic_titlebar"
                   HorizontalAlignment="Left" 
                   Width="16" Height="16" 
                   Grid.Column="0"
                   VerticalAlignment="Center"/>

            <TextBlock
                Margin="12,0,0,0"
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Romanowsky Stain Slide Analyzer"/>
        </Grid>

        <NavigationView
            IsBackButtonVisible="Visible"
            Canvas.ZIndex="0"
            DisplayModeChanged="OnDisplayModeChanged"
            Grid.Row="1"
            x:Name="NavView"
            BackRequested="OnBackRequested"
            ItemInvoked="OnItemInvoked"
            IsTitleBarAutoPaddingEnabled="False"
            AlwaysShowHeader="True">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Segmentation" Icon="Find" Tag="RomanowskyStainSlideAnalyzer.Home.View.HomeView" IsSelected="True"/>
                <NavigationViewItem Content="History" Tag="RomanowskyStainSlideAnalyzer.History.View.HistoryView" Icon="Rotate"/>
                <NavigationViewItem Content="Analytics" Tag="RomanowskyStainSlideAnalyzer.Analytics.View.AnalyticsView" Icon="Filter"/>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame"/>
        </NavigationView>
    </Grid>
</Window>
