<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RomanowskyStainSlideAnalyzer.History.View.HistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RomanowskyStainSlideAnalyzer.History.View"
    xmlns:model="using:RomanowskyStainSlideAnalyzer.History.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="HistoryListItemTemplate" x:DataType="model:HistoryDataModel">
            <ItemContainer AutomationProperties.Name="{x:Bind date, Mode=TwoWay}">
                <Expander
                    IsExpanded="False"
                    Header="{x:Bind date, Mode=TwoWay}"
                    ExpandDirection="Down"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Stretch"
                    Margin="0 0 0 10"
                    HorizontalContentAlignment="Stretch">
                    
                    <Expander.Content>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="512"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Image Width="512" Height="512" Grid.Column="0" Source="{x:Bind imagePath, Mode=TwoWay}" Stretch="Uniform"/>

                            <StackPanel Margin="10 0 0 0" Orientation="Vertical" Grid.Column="1">
                                <TextBlock Text="{x:Bind log, Mode=TwoWay}"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <Button x:Name="btn_showData" Click="OnLabelingOptionClick" Visibility="{x:Bind showSaveButton, Mode=TwoWay}" Foreground="{StaticResource TextOnAccentAAFillColorPrimary}" Background="{StaticResource SystemAccentColor}">Analyze Bounding Box</Button>
                                    <Button x:Name="btn_changeLabelingData" Margin="10 0 0 0" Click="ChangeLabelingData" Visibility="{x:Bind showSaveButton, Mode=TwoWay}">Change Labeling Data</Button>
                                    <Button x:Name="btn_saveLabelingData" Margin="10 0 0 0" Visibility="{x:Bind showSaveButton, Mode=TwoWay}" Click="OnClick">Save Labeling Data</Button>
                                    <Button x:Name="btn_saveImageWithBBox" Margin="10 0 0 0" Visibility="{x:Bind showSaveButton, Mode=TwoWay}" Click="SaveImageWithBBoxes">Save Image with Bounding Boxes</Button>
                                    <ProgressRing x:Name="progressRing" IsIndeterminate="True" Visibility="{x:Bind showProgress, Mode=TwoWay}" Margin="10 0 0 0"/>
                                    <Button x:Name="btn_saveImage" Margin="10 0 0 0" Click="OnClick">Save Result Image</Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Expander.Content>

                </Expander>
            </ItemContainer>
        </DataTemplate>
    </Page.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DatePicker Grid.Row="0" Date="{x:Bind Date, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" x:Name="datePicker"/>

        <ProgressRing Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{x:Bind ShowProgress, Mode=TwoWay}" IsIndeterminate="True"/>

        <ScrollView Grid.Row="1" x:Name="listView" VerticalAlignment="Stretch" Margin="0 10 0 0">
            <StackPanel Orientation="Vertical">
                <ListView
                    x:Name="historyListView"
                    SelectionMode="None"
                    ItemTemplate="{StaticResource HistoryListItemTemplate}"
                    BorderThickness="0"
                    BorderBrush="{ThemeResource SystemControlTransparentBrush}"
                    HorizontalContentAlignment="Stretch"
                    Margin="0 20 0 10"/>
            </StackPanel>
        </ScrollView>
        
        <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" x:Name="emptyPanel" Grid.Row="1">
            <SymbolIcon Symbol="Cancel" Foreground="Gray"/>
            <TextBlock Text="There are no records for the selected date." Foreground="Gray"/>
        </StackPanel>
    </Grid>
</Page>
