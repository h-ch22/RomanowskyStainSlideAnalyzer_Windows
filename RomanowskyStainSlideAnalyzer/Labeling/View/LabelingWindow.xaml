<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="RomanowskyStainSlideAnalyzer.Labeling.View.LabelingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RomanowskyStainSlideAnalyzer.Labeling.View"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Labeling">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="512"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" x:Name="AppTitleBar" Height="48" Margin="20,0,0,0" VerticalAlignment="Top" Padding="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <SymbolIcon Symbol="Caption"
                        x:Name="ic_titlebar"
                        HorizontalAlignment="Left" 
                        Grid.Column="0"
                        VerticalAlignment="Center"/>

            <TextBlock
                Margin="12,0,0,0"
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Labeling"/>
        </Grid>

        <CommandBar Grid.Row="1" Background="Transparent" DefaultLabelPosition="Right">
            <AppBarToggleButton IsChecked="{x:Bind viewModel.IsZoomModeEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Icon="Zoom" Label="Zoom Mode"/>
        </CommandBar>

        <StackPanel Grid.Row="2" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <SymbolIcon Symbol="Caption" Foreground="Gray"/>
                <TextBlock Margin="10 0 0 0" Text="Please select a class.&#x0a;With ZoomMode turned on, you can zoom in and out by holding down the Ctrl key while scrolling." Foreground="Gray"/>
            </StackPanel>

            <TextBlock Margin="0 10 0 0" HorizontalAlignment="Center" TextAlignment="Center" FontWeight="SemiBold" Text="{x:Bind viewModel.CurrentBoundingBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0 5 0 10">
                <TextBlock Text="{x:Bind viewModel.CurrentIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Foreground="Gray"/>
                <TextBlock Text=" / " FontSize="12" Foreground="Gray"/>
                <TextBlock Text="{x:Bind viewModel.AllIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Foreground="Gray"/>
            </StackPanel>
        </StackPanel>

        <ScrollView Grid.Row="3" Width="512" Height="512" ContentOrientation="None" ZoomMode="{x:Bind viewModel.ZoomMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsTabStop="True" HorizontalAlignment="Center" VerticalAlignment="Center"
                    HorizontalScrollMode="Auto" VerticalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Canvas Opacity="1" x:Name="canvas" Width="512" Height="512">
                <Image x:Name="img_source" Source="{x:Bind viewModel.Source, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="512" Height="512" Stretch="Fill">
                    <Image.RenderTransform>
                        <RotateTransform Angle="270" CenterX="256" CenterY="256"/>
                    </Image.RenderTransform>
                </Image>
            </Canvas>

        </ScrollView>

        <RadioButtons Margin="20" Grid.Row="4" Header="Select Class">
            <RadioButton x:Name="radio_A" Content="A" IsChecked="True" Checked="OnClassSelected"/>
            <RadioButton x:Name="radio_B" Content="B" Checked="OnClassSelected"/>
            <RadioButton x:Name="radio_C" Content="C" Checked="OnClassSelected"/>
        </RadioButtons>

        <StackPanel Grid.Row="5" Margin="20" HorizontalAlignment="Center">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="5*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btn_previous" IsEnabled="False" Click="OnClick" Grid.Column="0">Previous</Button>
                <Button x:Name="btn_next" Content="Next" Click="OnClick" Grid.Column="1" Margin="10 0 0 0" Background="{StaticResource SystemAccentColor}" Foreground="{StaticResource TextOnAccentFillColorPrimary}"></Button>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
